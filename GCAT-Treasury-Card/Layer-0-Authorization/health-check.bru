meta {
  name: Health Check — jPOS Authorization Host
  type: http
  seq: 1
}

get {
  url: {{jpos_host}}/health
  body: none
  auth: none
}

tests {
  test("status is healthy", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("healthy");
    expect(res.body.gcat_pan).to.equal("9000002500000001");
  });
}